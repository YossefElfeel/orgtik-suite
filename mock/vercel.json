{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "includeFiles": "{apps,lib,config.js,server.js}/**",
      "maxDuration": 60,
      "memory": 2048
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
