{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "fra1"
  ],
  "services": {
    "admin": {
      "root": "apps/admin",
      "framework": "nextjs",
      "installCommand": "cd ../.. && npx --yes pnpm@11.3.0 install --frozen-lockfile",
      "buildCommand": "node ../../tools/services/run.cjs build admin",
      "devCommand": "node ../../tools/services/run.cjs dev admin",
      "bindings": [
        {
          "type": "service",
          "service": "mock",
          "format": "url",
          "env": "ORGTIK_MOCK_URL"
        }
      ]
    },
    "chats": {
      "root": "apps/chats",
      "framework": "nextjs",
      "installCommand": "cd ../.. && npx --yes pnpm@11.3.0 install --frozen-lockfile",
      "buildCommand": "node ../../tools/services/run.cjs build chats",
      "devCommand": "node ../../tools/services/run.cjs dev chats",
      "bindings": [
        {
          "type": "service",
          "service": "mock",
          "format": "url",
          "env": "ORGTIK_MOCK_URL"
        }
      ]
    },
    "files": {
      "root": "apps/files",
      "framework": "nextjs",
      "installCommand": "cd ../.. && npx --yes pnpm@11.3.0 install --frozen-lockfile",
      "buildCommand": "node ../../tools/services/run.cjs build files",
      "devCommand": "node ../../tools/services/run.cjs dev files",
      "bindings": [
        {
          "type": "service",
          "service": "mock",
          "format": "url",
          "env": "ORGTIK_MOCK_URL"
        }
      ]
    },
    "hr": {
      "root": "apps/hr",
      "framework": "nextjs",
      "installCommand": "cd ../.. && npx --yes pnpm@11.3.0 install --frozen-lockfile",
      "buildCommand": "node ../../tools/services/run.cjs build hr",
      "devCommand": "node ../../tools/services/run.cjs dev hr",
      "bindings": [
        {
          "type": "service",
          "service": "mock",
          "format": "url",
          "env": "ORGTIK_MOCK_URL"
        }
      ]
    },
    "marketing": {
      "root": "apps/marketing",
      "framework": "nextjs",
      "installCommand": "cd ../.. && npx --yes pnpm@11.3.0 install --frozen-lockfile",
      "buildCommand": "node ../../tools/services/run.cjs build marketing",
      "devCommand": "node ../../tools/services/run.cjs dev marketing",
      "bindings": [
        {
          "type": "service",
          "service": "mock",
          "format": "url",
          "env": "ORGTIK_MOCK_URL"
        }
      ]
    },
    "sales": {
      "root": "apps/sales",
      "framework": "nextjs",
      "installCommand": "cd ../.. && npx --yes pnpm@11.3.0 install --frozen-lockfile",
      "buildCommand": "node ../../tools/services/run.cjs build sales",
      "devCommand": "node ../../tools/services/run.cjs dev sales",
      "bindings": [
        {
          "type": "service",
          "service": "mock",
          "format": "url",
          "env": "ORGTIK_MOCK_URL"
        }
      ]
    },
    "sos": {
      "root": "apps/sos",
      "framework": "nextjs",
      "installCommand": "cd ../.. && npx --yes pnpm@11.3.0 install --frozen-lockfile",
      "buildCommand": "node ../../tools/services/run.cjs build sos",
      "devCommand": "node ../../tools/services/run.cjs dev sos",
      "bindings": [
        {
          "type": "service",
          "service": "mock",
          "format": "url",
          "env": "ORGTIK_MOCK_URL"
        }
      ]
    },
    "tasks": {
      "root": "apps/tasks",
      "framework": "nextjs",
      "installCommand": "cd ../.. && npx --yes pnpm@11.3.0 install --frozen-lockfile",
      "buildCommand": "node ../../tools/services/run.cjs build tasks",
      "devCommand": "node ../../tools/services/run.cjs dev tasks",
      "bindings": [
        {
          "type": "service",
          "service": "mock",
          "format": "url",
          "env": "ORGTIK_MOCK_URL"
        }
      ]
    },
    "wm": {
      "root": "apps/wm",
      "framework": "nextjs",
      "installCommand": "cd ../.. && npx --yes pnpm@11.3.0 install --frozen-lockfile",
      "buildCommand": "node ../../tools/services/run.cjs build wm",
      "devCommand": "node ../../tools/services/run.cjs dev wm",
      "bindings": [
        {
          "type": "service",
          "service": "mock",
          "format": "url",
          "env": "ORGTIK_MOCK_URL"
        }
      ]
    },
    "website": {
      "root": "apps/website/landing-directions",
      "framework": "vite",
      "installCommand": "cd ../../.. && npx --yes pnpm@11.3.0 install --frozen-lockfile",
      "buildCommand": "node ../../../tools/services/run.cjs build website",
      "devCommand": "node ../../../tools/services/run.cjs dev website",
      "outputDirectory": "dist/client",
      "rewrites": [
        {
          "source": "/software/plans/:path*",
          "destination": "/software/plans/index.html"
        },
        {
          "source": "/pricing/plans",
          "destination": "/index.html"
        },
        {
          "source": "/:file*.dc.html",
          "destination": "/index.html"
        }
      ],
      "redirects": [
        {
          "source": "/platform",
          "destination": "/software#plan-builder",
          "permanent": true
        },
        {
          "source": "/pricing",
          "destination": "/software#plan-builder",
          "permanent": true
        },
        {
          "source": "/platform/:path*",
          "destination": "/software/:path*",
          "permanent": true
        },
        {
          "source": "/projects",
          "destination": "/work",
          "permanent": true
        },
        {
          "source": "/projects/:path*",
          "destination": "/work/:path*",
          "permanent": true
        },
        {
          "source": "/privacy",
          "destination": "/legal/privacy",
          "permanent": true
        },
        {
          "source": "/terms",
          "destination": "/legal/terms",
          "permanent": true
        },
        {
          "source": "/imprint",
          "destination": "/legal/imprint",
          "permanent": true
        },
        {
          "source": "/sample-campaign",
          "destination": "/services",
          "permanent": false
        },
        {
          "source": "/sample-renamed",
          "destination": "/services",
          "permanent": true
        },
        {
          "source": "/sample-retired",
          "destination": "/services",
          "permanent": true
        }
      ],
      "headers": [
        {
          "source": "/(.*)",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        }
      ]
    },
    "mock": {
      "root": "mock",
      "framework": "express",
      "entrypoint": "index.js",
      "devCommand": "node services-dev.cjs",
      "installCommand": "cd .. && npx --yes pnpm@11.3.0 install --frozen-lockfile",
      "functions": {
        "index.js": {
          "includeFiles": "{apps,lib,api}/**",
          "maxDuration": 60,
          "memory": 2048,
          "excludeFiles": "**/apps/files/assets/hls/**/*.ts"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/admin/:path*",
      "destination": {
        "service": "admin"
      }
    },
    {
      "source": "/chats/:path*",
      "destination": {
        "service": "chats"
      }
    },
    {
      "source": "/files/:path*",
      "destination": {
        "service": "files"
      }
    },
    {
      "source": "/hr/:path*",
      "destination": {
        "service": "hr"
      }
    },
    {
      "source": "/marketing/:path*",
      "destination": {
        "service": "marketing"
      }
    },
    {
      "source": "/sales/:path*",
      "destination": {
        "service": "sales"
      }
    },
    {
      "source": "/sos/:path*",
      "destination": {
        "service": "sos"
      }
    },
    {
      "source": "/tasks/:path*",
      "destination": {
        "service": "tasks"
      }
    },
    {
      "source": "/wm/:path*",
      "destination": {
        "service": "wm"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "website"
      }
    }
  ]
}
