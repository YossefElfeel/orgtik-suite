{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "fra1"
  ],
  "services": {
    "website": {
      "root": "apps/website/landing-directions",
      "framework": "vite",
      "installCommand": "cd ../../.. && npx --yes pnpm@11.3.0 install --frozen-lockfile",
      "buildCommand": "node ../../../tools/services/run.cjs build website",
      "devCommand": "node ../../../tools/services/run.cjs dev website",
      "outputDirectory": "dist/client",
      "rewrites": [
        {
          "source": "/software/plans/:path*",
          "destination": "/software/plans/index.html"
        },
        {
          "source": "/pricing/plans",
          "destination": "/index.html"
        },
        {
          "source": "/:file*.dc.html",
          "destination": "/index.html"
        }
      ],
      "redirects": [
        {
          "source": "/platform",
          "destination": "/software#plan-builder",
          "permanent": true
        },
        {
          "source": "/pricing",
          "destination": "/software#plan-builder",
          "permanent": true
        },
        {
          "source": "/platform/:path*",
          "destination": "/software/:path*",
          "permanent": true
        },
        {
          "source": "/projects",
          "destination": "/work",
          "permanent": true
        },
        {
          "source": "/projects/:path*",
          "destination": "/work/:path*",
          "permanent": true
        },
        {
          "source": "/privacy",
          "destination": "/legal/privacy",
          "permanent": true
        },
        {
          "source": "/terms",
          "destination": "/legal/terms",
          "permanent": true
        },
        {
          "source": "/imprint",
          "destination": "/legal/imprint",
          "permanent": true
        },
        {
          "source": "/sample-campaign",
          "destination": "/services",
          "permanent": false
        },
        {
          "source": "/sample-renamed",
          "destination": "/services",
          "permanent": true
        },
        {
          "source": "/sample-retired",
          "destination": "/services",
          "permanent": true
        }
      ],
      "headers": [
        {
          "source": "/(.*)",
          "headers": [
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": "https://orgtik-suite-services-admin.vercel.app/admin"
    },
    {
      "source": "/admin/",
      "destination": "https://orgtik-suite-services-admin.vercel.app/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://orgtik-suite-services-admin.vercel.app/admin/:path*"
    },
    {
      "source": "/chats",
      "destination": "https://orgtik-suite-services-chats.vercel.app/chats"
    },
    {
      "source": "/chats/",
      "destination": "https://orgtik-suite-services-chats.vercel.app/chats"
    },
    {
      "source": "/chats/:path*",
      "destination": "https://orgtik-suite-services-chats.vercel.app/chats/:path*"
    },
    {
      "source": "/files",
      "destination": "https://orgtik-suite-services-files.vercel.app/files"
    },
    {
      "source": "/files/",
      "destination": "https://orgtik-suite-services-files.vercel.app/files"
    },
    {
      "source": "/files/:path*",
      "destination": "https://orgtik-suite-services-files.vercel.app/files/:path*"
    },
    {
      "source": "/hr",
      "destination": "https://orgtik-suite-services-hr.vercel.app/hr"
    },
    {
      "source": "/hr/",
      "destination": "https://orgtik-suite-services-hr.vercel.app/hr"
    },
    {
      "source": "/hr/:path*",
      "destination": "https://orgtik-suite-services-hr.vercel.app/hr/:path*"
    },
    {
      "source": "/marketing",
      "destination": "https://orgtik-suite-services-marketing.vercel.app/marketing"
    },
    {
      "source": "/marketing/",
      "destination": "https://orgtik-suite-services-marketing.vercel.app/marketing"
    },
    {
      "source": "/marketing/:path*",
      "destination": "https://orgtik-suite-services-marketing.vercel.app/marketing/:path*"
    },
    {
      "source": "/sales",
      "destination": "https://orgtik-suite-services-sales.vercel.app/sales"
    },
    {
      "source": "/sales/",
      "destination": "https://orgtik-suite-services-sales.vercel.app/sales"
    },
    {
      "source": "/sales/:path*",
      "destination": "https://orgtik-suite-services-sales.vercel.app/sales/:path*"
    },
    {
      "source": "/sos",
      "destination": "https://orgtik-suite-services-sos.vercel.app/sos"
    },
    {
      "source": "/sos/",
      "destination": "https://orgtik-suite-services-sos.vercel.app/sos"
    },
    {
      "source": "/sos/:path*",
      "destination": "https://orgtik-suite-services-sos.vercel.app/sos/:path*"
    },
    {
      "source": "/tasks",
      "destination": "https://orgtik-suite-services-tasks.vercel.app/tasks"
    },
    {
      "source": "/tasks/",
      "destination": "https://orgtik-suite-services-tasks.vercel.app/tasks"
    },
    {
      "source": "/tasks/:path*",
      "destination": "https://orgtik-suite-services-tasks.vercel.app/tasks/:path*"
    },
    {
      "source": "/wm",
      "destination": "https://orgtik-suite-services-wm.vercel.app/wm"
    },
    {
      "source": "/wm/",
      "destination": "https://orgtik-suite-services-wm.vercel.app/wm"
    },
    {
      "source": "/wm/:path*",
      "destination": "https://orgtik-suite-services-wm.vercel.app/wm/:path*"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "website"
      }
    }
  ]
}
