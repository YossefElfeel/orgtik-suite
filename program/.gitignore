# Screenshots from sweeps are regenerated on demand; commit only the ones cited as evidence.
audits/**/shots/
# Trial runs of the audit kit (--label smoke) and partial runs (--route) aren't records.
audits/**/*-smoke.*
audits/*-smoke.*
audits/**/*-subset.*
audits/*-subset.*
# Python bytecode from the tools.
__pycache__/
# The audit kit's installed packages.
tools/audit-kit/node_modules/
# Website parity screenshots and diff images: regenerated from the tagged site commit.
audits/website/parity/*/*.png
audits/website/parity/diff-*/
tools/qa/node_modules/
# Flow walk screenshots: regenerated by tools/audit-kit/flows/*.mjs (a share walk shows a link's secret).
audits/*/flows/**/*.png
# Local follow-up screenshots are reproducible from the committed flows and capture manifests.
audits/wm/followup/*.png
audits/website/connection/edited-home.png
audits/website/roadmap-followup.png
